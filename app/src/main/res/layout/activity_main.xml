<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NyugiGuard"
            android:textSize="26sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/switchEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Háttérszolgáltatás bekapcsolva"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/textLastRun"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/seekInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/textBrightness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/seekBrightness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/textVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/seekVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/buttonApplyNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Alkalmazás most" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Health check"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/switchHealth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Health check bekapcsolva"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/editHealthUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="IP vagy link (pl. 192.168.1.10:8080/ping)"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:singleLine="true" />

        <Button
            android:id="@+id/buttonHealthSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cím mentése" />

        <TextView
            android:id="@+id/textHealthInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/seekHealthInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/textHealthStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Szükséges engedélyek"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textPermWrite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="15sp" />

        <Button
            android:id="@+id/buttonPermWrite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fényerő-módosítás engedélyezése" />

        <TextView
            android:id="@+id/textPermDnd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="15sp" />

        <Button
            android:id="@+id/buttonPermDnd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ne zavarjanak hozzáférés engedélyezése" />

        <TextView
            android:id="@+id/textPermBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="15sp" />

        <Button
            android:id="@+id/buttonPermBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Akkumulátor-korlátozás kikapcsolása" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Xiaomi: a Biztonság app / Alkalmazások kezelése / NyugiGuard alatt kapcsold be az Automatikus indítást, és az akkumulátor-takarékosságot állítsd Nincs korlátozásra."
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
